# Copy to .env (never commit it). Names match application.yml placeholders.
SERVER_PORT=8080
# The public origin(s) the web app is served from — the STOMP endpoint checks the browser's Origin.
ALLOWED_ORIGINS=https://domingoos.store,https://www.domingoos.store

DB_HOST=
DB_PORT=3306
DB_NAME=bunny_code
DB_USER=
DB_PASSWORD=
# docker-compose only
DB_ROOT_PASSWORD=

CACHE_HOST=
CACHE_PORT=6379
CACHE_USER=
CACHE_PASSWORD=

INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=
# docker-compose only (first start of the InfluxDB container)
INFLUX_ADMIN_USER=
INFLUX_ADMIN_PASSWORD=

# >= 32 bytes; the app refuses to start with a shorter secret.
JWT_SECRET_KEY=

AWS_REGION=ap-northeast-1
AWS_BUCKET_NAME=
AWS_DISTRIBUTION_NAME=
S3_RECORD_FOLDER=record
S3_BATTLE_FOLDER=battle
DEFAULT_TEMPLATE_FILE=/record/user_0/project_0/version_0/test.js

# ssh = remote sandbox hosts from the `host` table; local = Docker on this machine (dev only).
SANDBOX_MODE=ssh
SANDBOX_IMAGE=node-tool
# Inside the api container; docker-compose.yml mounts the key from SANDBOX_SSH_KEY_PATH (default
# Docker/secrets/sandbox_key, owned by uid 10001, mode 600) to this path.
SSH_IDENTITY_FILE=/run/secrets/sandbox_key
CPU_THRESHOLD=0.8
MEM_THRESHOLD=0.8

